# Caddy provisions Let's Encrypt certificates automatically for a real DOMAIN.
# With DOMAIN=localhost it issues its own local certificates instead — fine for
# poking at hawk-shop, but the two Slack apps need publicly reachable HTTPS
# hostnames because Slack delivers to them from Slack's own servers.

# The portal lives at apps.<domain>, not the bare domain — the root of
# redhawkrobotics.org is the team website, hosted elsewhere. Nothing here
# serves the bare domain, so its DNS should not point at this host.
apps.{$DOMAIN} {
	root * /srv/portal
	file_server
}

shop.{$DOMAIN} {
	reverse_proxy hawk-shop:3000 {
		# hawk-shop builds absolute redirects from the request rather than from
		# APP_URL, and this proxy talks to it over plain HTTP, so it emits
		# "Location: http://shop...". In a browser tab Caddy just bounces that
		# back to HTTPS. Inside Onshape's HTTPS iframe it is mixed content, which
		# Chrome blocks silently — the panel renders blank with no error.
		#
		# Belongs upstream (X-Forwarded-Proto is already set on the way in), but
		# routing is this repo's job and the embedded view is unusable without it.
		header_down Location "^http://" "https://"
	}
}

mod.{$DOMAIN} {
	reverse_proxy hawk-mod:3000
}

bot.{$DOMAIN} {
	reverse_proxy hawk-bot:3000
}

# Hawk Eye exposes read-only event/provider views and design docs.
# Keep scouting APIs and mutation routes blocked until authorization exists.
scout.{$DOMAIN} {
	@docs {
		method GET HEAD
		path / /docs/* /_astro/* /pagefind/* /brand/* /favicon.ico /favicon.svg /health
	}
	handle @docs {
		reverse_proxy hawk-eye:3000
	}
	@eventViews {
		method GET HEAD
		path_regexp eventViews ^/(events/[0-9]{4}[a-z0-9]+(/(teams/[1-9][0-9]{0,4}|updates[.]json))?|teams/[1-9][0-9]{0,4})/?$
	}
	handle @eventViews {
		reverse_proxy hawk-eye:3000
	}
	handle {
		respond "Hawk Eye scouting is not available yet." 503
	}
	# Return a controlled response if the app is unavailable.
	handle_errors {
		respond "Hawk Eye documentation is not available yet." 503
	}
}
