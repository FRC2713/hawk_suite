#!/usr/bin/env python3
"""Restricted SSH entry point. Install root-owned outside the checkout.

The only input is a JSON deployment envelope on stdin. Fetch and authorize an
exact main revision before executing that revision's deployment implementation.
Changes to this small launcher require re-running provision-host.sh.
"""
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import signal
import sys


def main():
    stack = Path(os.environ.get('STACK_DIR', '/opt/hawk_suite')).resolve()
    state = stack / '.deploy'
    state.mkdir(mode=0o700, exist_ok=True)
    os.chmod(state, 0o700)
    with (state / 'lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        # Limit input and reject malformed or ambiguous requests before mutation.
        signal.alarm(15)
        raw = sys.stdin.buffer.read(131073)
        signal.alarm(0)
        if len(raw) > 131072:
            raise ValueError('deployment request too large')
        request = json.loads(raw)
        sha = request.get('suite_sha', '')
        if not re.fullmatch(r'[a-f0-9]{40}', sha):
            raise ValueError('invalid suite revision')
        if not isinstance(request.get('env'), dict):
            raise ValueError('missing deployment environment')
        subprocess.run(['git', '-C', str(stack), 'fetch', '--quiet', 'origin', 'main'], check=True)
        current = subprocess.check_output(['git', '-C', str(stack), 'rev-parse', 'origin/main'], text=True).strip()
        if sha != current:
            print('Stale deployment: approved revision is no longer main. Start a new Deploy run.', file=sys.stderr)
            raise ValueError('stale revision')
        target = state / 'releases' / sha
        target.parent.mkdir(exist_ok=True)
        if not target.exists():
            subprocess.run(['git', '-C', str(stack), 'worktree', 'add', '--quiet', '--detach', str(target), sha], check=True)
        # Never execute a modified staged checkout, including untracked code.
        dirty = subprocess.check_output(['git', '-C', str(target), 'status', '--porcelain'], text=True).strip()
        if dirty:
            raise ValueError('staged release was modified; inspect it on the host')
        subprocess.run([sys.executable, str(target / 'scripts/deploy.py'), str(stack), str(target)],
                       input=json.dumps(request), text=True, check=True)


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError):
        # Never print exceptions carrying request/environment values.
        print('Deploy refused or failed. Check the revision, host lock and deployment diagnostics.', file=sys.stderr)
        sys.exit(1)
