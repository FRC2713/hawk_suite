{
	admin localhost:2019
	log {
		output discard
	}
	order authenticate before respond
	order authorize before reverse_proxy
	security {
		oauth identity provider slack_suite {
			realm slack
			driver generic
			client_id __CLIENT_ID__
			client_secret __CLIENT_SECRET__
			base_auth_url https://slack.com
			metadata_url https://slack.com/.well-known/openid-configuration
			scopes openid profile email
			response_type code
			extract sub https://slack.com/team_id https://slack.com/user_id from userinfo
		}
		authentication portal suite {
			ui {
				template login /etc/hawk-auth/login.template
				template portal /etc/hawk-auth/portal.template
			}
			enable identity provider slack_suite
			trust login redirect uri domain exact apps.__DOMAIN__ path prefix /
			trust login redirect uri domain exact shop.__DOMAIN__ path prefix /
			trust login redirect uri domain exact scout.__DOMAIN__ path prefix /
			trust login redirect uri domain exact mod.__DOMAIN__ path prefix /
			trust login redirect uri domain exact bot.__DOMAIN__ path prefix /
			crypto default token lifetime 604800
			crypto key suite-production sign from file /etc/hawk-auth/private.pem
			crypto key suite-production verify from file /etc/hawk-auth/public.pem
			cookie insecure off
			cookie domain __DOMAIN__
			cookie samesite lax
			transform user {
				match role slack/workspace/__TEAM_ID__
				action add role suite/member authp/user
				action overwrite aud hawk-suite
				action overwrite iss https://apps.__DOMAIN__/
			}
			transform user {
				no match role suite/member
				block
			}
		}
		authorization policy suite {
			inject headers with claims
			inject header X-Hawk-Slack-Team from slack_team_id
			inject header X-Hawk-Slack-User from slack_user_id
			set auth url https://apps.__DOMAIN__/auth/
			set token sources header cookie
			validate bearer header
			crypto key suite-production verify from file /etc/hawk-auth/public.pem
			acl rule {
				match role suite/member
				match iss https://apps.__DOMAIN__/
				match aud hawk-suite
				allow stop
			}
			acl default deny
		}

		authorization policy shop_session {
			inject headers with claims
			inject header X-Hawk-Slack-Team from slack_team_id
			inject header X-Hawk-Slack-User from slack_user_id
			disable auth redirect
			set token sources header cookie
			validate bearer header
			crypto key suite-production verify from file /etc/hawk-auth/public.pem
			acl rule {
				match role suite/member
				match iss https://apps.__DOMAIN__/
				match aud hawk-suite
				allow stop
			}
			acl default deny
		}
	}
}

# Clear before authorization: missing claims must not preserve caller input.
(clear-suite-identity) {
    request_header -X-Token-Subject
    request_header -X-Token-User-Name
    request_header -X-Token-User-Email
    request_header -X-Token-User-Roles
    request_header -X-Hawk-Slack-Team
    request_header -X-Hawk-Slack-User
    request_header -X-Hawk-Identity
}
(auth-assets) {
    handle_path /suite-assets/* {
        root * /srv/auth-assets
        file_server {
            hide *.template *.md
        }
    }
}
(auth-portal) {
    header Cache-Control "no-store"
    respond /auth/api/refresh_token "Sign in again to continue." 401
    route /auth* {
        authenticate with suite
    }
}
apps.__DOMAIN__ {
  route {
    import clear-suite-identity
    import auth-assets
    import auth-portal
    redir / /auth/portal 302
    respond "Page not found." 404
}
}
(eye-proxy) {
    # Cookies pass through, like Mod and Bot: Hawk Eye verifies the signed
    # AUTHP_ACCESS_TOKEN session itself and reads its own app cookies.
    reverse_proxy hawk-eye:3000 {
        header_up -Authorization
        header_up -X-Hawk-Identity
    }
}
(eye-protected) {
    authorize with suite
    import eye-proxy
}
# MCP OAuth (docs/hawk-eye-mcp-oauth.md). Public OAuth endpoints never see a
# Suite cookie or a caller's Authorization header.
(eye-oauth-proxy) {
    reverse_proxy hawk-eye:3000 {
        header_up -Authorization
        header_up -Cookie
        header_up -X-Hawk-Identity
    }
}
# The client's bearer token is the only credential /mcp accepts. Cookies are
# dropped so a browser session can never authorize an MCP call.
(eye-mcp-proxy) {
    reverse_proxy hawk-eye:3000 {
        header_up -Cookie
        header_up -X-Hawk-Identity
    }
}
scout.__DOMAIN__ {
  route {
    import clear-suite-identity
    @health {
        method GET HEAD
        path /health
    }
    handle @health {
        reverse_proxy hawk-eye:3000
    }
    # Static assets contain no scouting data and are needed by partner boards.
    @eyeAssets {
        method GET HEAD
        path /_astro/* /brand/* /favicon.ico /favicon.svg
    }
    route @eyeAssets {
        import eye-proxy
    }
    # Eye checks the revocable share-code cookie and filters the partner view.
    # A partner does not need a Slack workspace membership.
    @partnerPages {
        method GET HEAD
        path /picklist /picklist/ /picklist/state.json
    }
    route @partnerPages {
        import eye-proxy
    }
    @partnerForms {
        method POST
        path /picklist /picklist/
        expression {http.request.uri.query} == '_action=joinPickList' || {http.request.uri.query} == '_action=leavePickList'
    }
    route @partnerForms {
        import eye-proxy
    }
    @partnerActions {
        method POST
        path_regexp partnerActions ^/_actions/(joinPickList|leavePickList|postSharedPickListMessage)/?$
        expression {http.request.uri.query} == ''
    }
    route @partnerActions {
        import eye-proxy
    }
    @pages {
        method GET HEAD
        path / /docs/* /pagefind/*
    }
    route @pages {
        import eye-protected
    }
    @events {
        method GET HEAD
        path_regexp events ^/(events/[0-9]{4}[a-z0-9]+(/(teams/[1-9][0-9]{0,4}|updates[.]json|picklist|picklist[.]json))?|teams/[1-9][0-9]{0,4})/?$
    }
    route @events {
        import eye-protected
    }
    # The team's own pick list edits and chat. Eye verifies the signed Slack
    # session and its reader grants on every call.
    @pickListActions {
        method POST
        path_regexp pickListActions ^/_actions/(editPickList|sharePickList|postPickListMessage)/?$
        expression {http.request.uri.query} == ''
    }
    route @pickListActions {
        import eye-protected
    }
    # Members upload a JSON file of reports. The page posts back to itself
    # with no query string; Eye validates the whole file in one transaction.
    @reportImport {
        method GET HEAD POST
        path /reports/import /reports/import/
        expression {http.request.uri.query} == ''
    }
    route @reportImport {
        import eye-protected
    }
    # MCP clients discover, register and exchange tokens without a Suite
    # session. Eye checks PKCE, client, redirect URI and rate limits.
    @eyeOAuthMetadata {
        method GET HEAD
        path /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/mcp /.well-known/oauth-authorization-server
    }
    route @eyeOAuthMetadata {
        import eye-oauth-proxy
    }
    @eyeOAuthPublic {
        method POST
        path /oauth/register /oauth/token /oauth/revoke
        expression {http.request.uri.query} == ''
    }
    route @eyeOAuthPublic {
        import eye-oauth-proxy
    }
    # Consent and connected apps need a signed-in member. Eye's form actions
    # post back to these paths with an _action query.
    @eyeOAuthMember {
        method GET HEAD POST
        path /oauth/authorize /oauth/connections
    }
    route @eyeOAuthMember {
        import eye-protected
    }
    # Stateless Streamable HTTP. Eye answers GET and DELETE with 405.
    @eyeMcp {
        method POST GET DELETE
        path /mcp
        expression {http.request.uri.query} == ''
    }
    route @eyeMcp {
        import eye-mcp-proxy
    }
    respond "Hawk Eye scouting is not available yet." 503
  }
    handle_errors {
        respond "Hawk Eye is temporarily unavailable." 503
    }
}
(shop-proxy) {
    # Like Eye: cookies pass through and Shop reads the injected identity headers.
    # The Location rewrite keeps redirects on HTTPS inside Onshape's iframe.
    reverse_proxy hawk-shop:3000 {
        header_up -Authorization
        header_up -X-Hawk-Identity
        header_down Location "^http://" "https://"
    }
}
(shop-protected) {
    authorize with suite
    import shop-proxy
}
# Shop is gated like Eye. Shop verifies the Suite identity on every data route.
shop.__DOMAIN__ {
  route {
    import clear-suite-identity
    @shopHealth {
        method GET HEAD
        path /api/health /health
    }
    route @shopHealth {
        import shop-proxy
    }
    # Onshape authenticates this exact callback with Shop's shared secret.
    @shopOnshapeWebhook {
        method POST
        path /api/onshape/webhook
    }
    route @shopOnshapeWebhook {
        import shop-proxy
    }
    # The popup must authenticate using Suite's ordinary top-level session.
    # Never accept the embedded cookie as the authority for issuing new codes.
    @shopPopup path /auth/embed/authorize /auth/embed/authorize/
    route @shopPopup {
        request_header -Authorization
        import shop-protected
    }
    # These endpoints expose only the connection UI, static assets, and the
    # proof-bound code exchange. Shop still gates all data routes itself.
    @shopEmbedAssets {
        method GET HEAD
        path /_astro/* /brand/* /favicon.svg
    }
    route @shopEmbedAssets {
        import shop-proxy
    }
    @shopEmbedExchange {
        method POST
        path /auth/embed/exchange
    }
    route @shopEmbedExchange {
        import shop-proxy
    }
    # CHIPS keeps this copy of the Suite token inside Onshape's partition.
    # Validate its signature, expiry, issuer, audience and role with the same
    # policy as the ordinary Suite cookie; never trust its mere presence.
    @shopEmbeddedSession header Cookie *__Host-hawk-shop-embedded=*
    route @shopEmbeddedSession {
        request_header Authorization "Bearer {http.request.cookie.__Host-hawk-shop-embedded}"
        authorize with shop_session
        import shop-proxy
    }
    # Fetches must receive 401 when the embedded cookie disappears, rather
    # than following a redirect into Slack inside the iframe.
    @shopApi path /api/* /auth/embed/session
    route @shopApi {
        authorize with shop_session
        import shop-proxy
    }
    @shopIframe {
        method GET HEAD
        path /onshape_connector /onshape_connector/
        header Sec-Fetch-Dest iframe
    }
    route @shopIframe {
        import shop-proxy
    }
    route {
        import shop-protected
    }
  }
  handle_errors {
    @expiredEmbed {
        expression {err.status_code} == 401 || {err.status_code} == 403
        method GET HEAD
        path /onshape_connector /onshape_connector/
        header Sec-Fetch-Dest iframe
    }
    route @expiredEmbed {
        import clear-suite-identity
        import shop-proxy
    }
    respond "Sign in with Hawk Suite to continue." {err.status_code}
  }

}
(slack-app) {
    @events {
        method POST
        path /slack/events
    }
    @callbacks {
        method GET
        path /slack/oauth_redirect
    }
    @health {
        method GET HEAD
        path /health
    }
    handle @events {
        reverse_proxy {args[0]} {
            header_up -X-Hawk-Identity
        }
    }
    handle @callbacks {
        reverse_proxy {args[0]} {
            header_up -X-Hawk-Identity
        }
    }
    handle @health {
        reverse_proxy {args[0]} {
            header_up -X-Hawk-Identity
        }
    }
    handle {
        route {
    import clear-suite-identity
            authorize with suite
            reverse_proxy {args[0]} {
                header_up -X-Hawk-Identity
            }
        }
    }
}
mod.__DOMAIN__ {
    route {
        import clear-suite-identity
        import slack-app hawk-mod:3000
    }
}
bot.__DOMAIN__ {
    route {
        import clear-suite-identity
        import slack-app hawk-bot:3000
    }
}
