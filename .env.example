# Copy to .env (or run ./setup.sh, which writes this file for you).
# Anything left blank falls back to the default shown in docker-compose.yml.

# ── Domain ────────────────────────────────────────────────────────────
# The root domain the suite is served from. Apps live on subdomains:
#   https://<DOMAIN>       portal
#   https://shop.<DOMAIN>  hawk-shop
#   https://mod.<DOMAIN>   hawk-mod
#   https://bot.<DOMAIN>   hawk-bot
# Point A records for <DOMAIN>, shop.<DOMAIN>, mod.<DOMAIN>, and bot.<DOMAIN>
# at the host (or one A record for <DOMAIN> plus a wildcard *.<DOMAIN>).
DOMAIN=

# Image tags to run. Pin to a released version (e.g. v1.2.0) once the season
# starts; `latest` tracks each repo's main branch.
HAWK_SHOP_TAG=latest
HAWK_MOD_TAG=latest
HAWK_BOT_TAG=latest


# ══ hawk-shop ═════════════════════════════════════════════════════════
# Onshape-driven manufacturing kanban. https://github.com/FRC2713/hawk-shop

# ── Onshape OAuth (required) ──────────────────────────────────────────
# Create an app at https://dev-portal.onshape.com/oauthApps and register
# https://shop.<DOMAIN>/auth/onshape/callback as its redirect URL.
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
# Both default to the shop.<DOMAIN> form; set them only to override.
# ONSHAPE_REDIRECT_URI=
# ONSHAPE_SCOPE=OAuth2Read OAuth2ReadPII OAuth2Write
# APP_URL=

# Set true only when serving over HTTPS *and* embedding hawk-shop in Onshape's
# iframe — it switches auth cookies to SameSite=None.
ONSHAPE_IFRAME_EMBED=false


# ══ hawk-mod ══════════════════════════════════════════════════════════
# Youth-protection DM monitoring for Slack. https://github.com/FRC2713/hawk-mod
# Slack reaches this from the public internet, so mod.<DOMAIN> must resolve
# publicly and serve real (not self-signed) HTTPS.

# ── Slack app credentials (required) ──────────────────────────────────
# Basic Information → App Credentials, in the Slack app you created from
# hawk-mod's docs/slack-app-manifest.yaml.
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Signs the OAuth state param: openssl rand -hex 32
SLACK_STATE_SECRET=

# Private channel that receives findings — the C… ID, not the name.
# Screened adults only.
ALERT_CHANNEL_ID=

# Encrypts adult Slack tokens at rest: openssl rand -base64 32
# NOT RECOVERABLE. Lose it and every adult has to re-authorize; leak it and the
# data volume alone is enough to read their DMs. Keep a copy wherever the
# team's other credentials live, not only on this host.
TOKEN_ENCRYPTION_KEY=

# Defaults to https://mod.<DOMAIN>; must match the Slack app manifest exactly.
# PUBLIC_URL=

# full     = store message text of monitored DMs
# metadata = store who/when/how-many only, never message text
LOG_MODE=full

# Slack user groups that declare roles (Business+ plans only). Leave unset to
# maintain the roster purely by CSV import.
STUDENT_USERGROUP=
ADULT_USERGROUP=

# Schedules (cron, in TZ). Defaults shown.
TZ=America/New_York
# SWEEP_CRON=0 3 * * *
# BACKFILL_CRON=15 * * * *
# DIGEST_CRON=0 8 * * *
# QUARTERLY_CRON=0 9 1 1,4,7,10 *


# ══ hawk-bot ══════════════════════════════════════════════════════════
# Team assistant for Slack. https://github.com/FRC2713/hawk-bot
# Like hawk-mod, Slack reaches this from the public internet, so bot.<DOMAIN>
# must resolve publicly and serve real HTTPS.

# ── Slack app credentials (required) ──────────────────────────────────
# A SECOND Slack app, separate from hawk-mod's — created from hawk-bot's
# docs/slack-app-manifest.yaml with every URL pointed at https://bot.<DOMAIN>.
# The HAWK_BOT_ prefix exists only here: inside its container the app reads the
# same unprefixed names hawk-mod does, and one .env holds both.
HAWK_BOT_SLACK_SIGNING_SECRET=
HAWK_BOT_SLACK_CLIENT_ID=
HAWK_BOT_SLACK_CLIENT_SECRET=
# Signs the OAuth state param: openssl rand -hex 32
HAWK_BOT_SLACK_STATE_SECRET=

# Encrypts the stored workspace installation, which carries the bot token:
#   openssl rand -base64 32
# Losing it costs one reinstall by a workspace admin. It is NOT the
# irreplaceable key that hawk-mod's TOKEN_ENCRYPTION_KEY above is.
HAWK_BOT_TOKEN_ENCRYPTION_KEY=

# Defaults to https://bot.<DOMAIN>; must match the Slack app manifest exactly.
# HAWK_BOT_PUBLIC_URL=
