# ── Domain ────────────────────────────────────────────────────────────
# The root domain the suite is served from. Apps live on subdomains:
#   https://<DOMAIN>        portal
#   https://scout.<DOMAIN>  QRScout
#   https://mfg.<DOMAIN>    rhr-mfg
# Point an A record for DOMAIN and *.DOMAIN at this machine.
# Leave as "localhost" for a pit laptop or local testing — everything
# works offline at https://localhost / https://scout.localhost.
DOMAIN=localhost

# ── rhr-mfg: Onshape OAuth ────────────────────────────────────────────
# Create an OAuth app at https://dev-portal.onshape.com
# The redirect URI must match your domain, e.g.
#   https://mfg.<DOMAIN>/api/auth/callback
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
ONSHAPE_REDIRECT_URI=
ONSHAPE_SCOPE=

# ── rhr-mfg: Supabase ─────────────────────────────────────────────────
# Project settings → API in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
